{
  "expo": {
    "name": "صحتي",
    "slug": "sahhti",
    "scheme": "sahhti",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "sa.sahhti.member",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Sahhti connects to the development API on the local network.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "sa.sahhti.member",
      "adaptiveIcon": {
        "backgroundColor": "#111614",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-sqlite",
      "expo-image",
      "expo-camera",
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "router": {}
    }
  }
}
