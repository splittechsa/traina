# Copy to .env for local API experiments. Never commit real secrets.
# Production auth, store verification, and Postgres are intentionally unset.

NODE_ENV=development
PORT=3040
# Neon credentials belong in the gitignored root .env, never in apps/mobile/.env.
# DATABASE_URL is the pooled URL. DATABASE_URL_UNPOOLED is the direct URL used for migrations.
# DATABASE_URL=postgres://sahhti:sahhti@localhost:5432/sahhti?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://sahhti:sahhti@localhost:5432/sahhti?sslmode=require
# Required for login/register (auth: session):
# SAHHTI_TOKEN_SECRET=generate-a-long-random-string
# SAHHTI_AUTH_MODE=session
# SAHHTI_DEV_TOKEN_SECRET=   # only for local hmac_dev; forbidden when NODE_ENV=production
# Coach stays unconfigured until all four are set. Do not put the key in the mobile app.
# SAHHTI_COACH_PROVIDER=openai_compatible
# SAHHTI_COACH_API_KEY=
# SAHHTI_COACH_BASE_URL=https://api.openai.com/v1
# SAHHTI_COACH_MODEL=
# Transactional email stays on the API. Leave these unset until a Resend domain is verified.
# SAHHTI_EMAIL_PROVIDER=resend
# SAHHTI_EMAIL_API_KEY=
# SAHHTI_EMAIL_FROM=Sahhti <noreply@example.com>
