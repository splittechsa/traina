# Copy to apps/mobile/.env. Do not commit .env.
# Physical devices cannot reach 127.0.0.1 — use the PC LAN IP or staging HTTPS.
# Never put SAHHTI_COACH_*, DATABASE_URL, or signing secrets in EXPO_PUBLIC_* or the binary.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3040
# Example LAN: EXPO_PUBLIC_API_URL=http://192.168.1.20:3040
# Example staging: EXPO_PUBLIC_API_URL=https://api-staging.example.com

