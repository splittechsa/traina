{
  "expo": {
    "name": "ترينا",
    "slug": "sahhti",
    "scheme": "sahhti",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "sa.sahhti.member",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "traina connects to the development API on the local network.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "sa.sahhti.member",
      "adaptiveIcon": {
        "backgroundColor": "#111614",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-sqlite",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "تستخدم ترينا الكاميرا لقراءة باركود الأطعمة فقط. traina uses the camera only to read food barcodes."
        }
      ],
      "expo-notifications",
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "تستخدم ترينا مستشعر الحركة لعدّ خطواتك اليومية. traina uses motion data to count your daily steps."
        }
      ],
      "expo-asset",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#17382D"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08645d48-eccc-471e-bd17-0354d7093033"
      }
    },
    "runtimeVersion": "0.1.0-staging.2",
    "updates": {
      "url": "https://u.expo.dev/08645d48-eccc-471e-bd17-0354d7093033"
    }
  }
}
